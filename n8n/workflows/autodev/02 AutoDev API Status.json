    {
      "parameters": {
        "jsCode": "const runId = String(($json.query && $json.query.run_id) || '').trim();\nif (!runId) return [{json: {run_id: '', found: false, error: 'MISSING_RUN_ID'}}];\nconst filter = JSON.stringify({filters: [{columnName: 'run_id', condition: 'eq', value: runId}]});\nreturn [{json: {run_id: runId, filter_raw: filter}}];"
      },
      "id": "parse-query",
      "name": "Parse Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://192.168.1.52:5678/api/v1/data-tables/P3Eyck556Y76TC4p/rows",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filter",
              "value": "={{ $json.filter_raw }}"
            }
          ]
        }
      },
      "id": "fetch-run-row",
      "name": "Fetch Run Row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
