      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', code: 'RUN_NOT_FOUND', run_id: $json.run_id }) }}"
      },
      "id": "respond-404",
      "name": "Respond 404",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 2,
      "position": [
        1200,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $json;\nconst filter = JSON.stringify({filters: [{columnName: 'run_id', condition: 'eq', value: s.run_id}]});\nreturn [{json: {run_id: s.run_id, row: s.row, filter_raw: filter}}];"
      },
      "id": "prep-attempt-query",
