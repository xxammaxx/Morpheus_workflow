      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Qy9ElX1H6XmeXGr9",
          "name": "autodev-n8n-api"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = ($json.data || []);\nconst runId = $('Parse Query').first().json.run_id || '';\nif (!rows.length) return [{json: {run_id: runId, found: false, row: null}}];\nreturn [{json: {run_id: runId, found: true, row: rows[0]}}];"
      },
      "id": "check-run-found",
      "name": "Check Run Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.found}}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          }
        }
      },
      "id": "run-found?",
      "name": "Run Found?",
