        "jsCode": "const s=$('Normalize Project Analysis').first().json;return s.issue_rows.map(issue=>({json:{filter:{filters:[{columnName:'project_id',condition:'eq',value:issue.project_id},{columnName:'issue_number',condition:'eq',value:issue.issue_number}]},data:issue,returnData:true}}));"
      },
