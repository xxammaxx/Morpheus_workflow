        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({filter:{filters:[{columnName:'project_id',condition:'eq',value:$json.project_row.project_id}]},data:$json.project_row,returnData:true}) }}",
        "options": {}
      },
      "id": "persist-project-projection",
