{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autodev.plan.v1",
  "title": "AutoDev Plan Contract v1",
  "description": "Read-only LLM plan with deterministic gate inputs.",
  "type": "object",
  "x-metadata": ["job_id", "attempt_id", "started_at", "ended_at", "duration_ms", "provider", "model", "backend"],
  "required": ["contract", "version", "run_id", "repository_head", "targets", "acceptance_criteria", "required_tests", "build_scope", "context", "safety"],
  "properties": {
    "contract": { "const": "autodev.plan.v1" },
    "version": { "const": "v1" },
    "run_id": { "type": "string", "minLength": 6, "maxLength": 64 },
    "repository_head": { "type": "string", "minLength": 7, "maxLength": 64 },
    "targets": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 256 } },
        "symbols": { "type": "array", "items": { "type": "string", "maxLength": 128 } }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4, "maxLength": 512 } },
    "required_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3, "maxLength": 256 } },
    "changes_expected": { "type": "boolean" },
    "risks": { "type": "array", "items": { "type": "string", "maxLength": 512 } },
    "build_scope": {
      "type": "object",
      "required": ["allowed_files"],
      "properties": {
        "allowed_files": { "type": "array", "items": { "type": "string", "maxLength": 256 } }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
        "research_summary": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["sentinel_absent", "repo_unchanged", "write_attempts"],
      "properties": {
        "sentinel_absent": { "const": true },
        "repo_unchanged": { "const": true },
        "write_attempts": { "type": "integer", "minimum": 0 },
        "denied_events": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "x-metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
