{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autodev.split.v1",
  "title": "AutoDev Split Contract v1",
  "description": "Deterministic decomposition of a blocked/stuck task into bounded subtasks.",
  "type": "object",
  "x-metadata": ["job_id", "attempt_id", "started_at", "ended_at", "duration_ms", "provider", "model", "backend"],
  "required": ["contract", "version", "parent_run_id", "reason", "subtasks", "acceptance_criteria", "limits"],
  "properties": {
    "contract": { "const": "autodev.split.v1" },
    "version": { "const": "v1" },
    "parent_run_id": { "type": "string", "minLength": 6, "maxLength": 64 },
    "reason": { "type": "string", "minLength": 4, "maxLength": 512 },
    "reason_code": { "type": "string", "maxLength": 128 },
    "subtasks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^st-[0-9]+$", "maxLength": 16 },
          "title": { "type": "string", "minLength": 3, "maxLength": 256 },
          "description": { "type": "string", "minLength": 10, "maxLength": 2000 }
        },
        "additionalProperties": false
      }
    },
    "dependencies": { "type": "array", "items": { "type": "array", "maxItems": 2, "items": { "type": "string", "maxLength": 16 } } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 512 } },
    "limits": {
      "type": "object",
      "required": ["max_split_depth", "max_subtasks", "current_depth"],
      "properties": {
        "max_split_depth": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_subtasks": { "type": "integer", "minimum": 2, "maximum": 10 },
        "current_depth": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "x-metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
