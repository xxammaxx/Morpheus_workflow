{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autodev.review-batch.v1",
  "title": "AutoDev Review Batch Contract v1",
  "description": "Joined review result across correctness/security/quality with parallelism proof.",
  "type": "object",
  "x-metadata": ["job_id", "attempt_id", "started_at", "ended_at", "duration_ms", "provider", "model", "backend"],
  "required": ["contract", "version", "run_id", "reviews", "blocked", "parallelism"],
  "properties": {
    "contract": { "const": "autodev.review-batch.v1" },
    "version": { "const": "v1" },
    "run_id": { "type": "string", "minLength": 6, "maxLength": 64 },
    "attempt_id": { "type": "string", "maxLength": 96 },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "verdict", "findings"],
        "properties": {
          "category": { "enum": ["correctness", "security", "quality"] },
          "verdict": { "enum": ["PASS", "FAIL"] },
          "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
        },
        "additionalProperties": false
      }
    },
    "blocked": { "type": "boolean" },
    "blocking_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "parallelism": {
      "type": "object",
      "required": ["jobs", "overlap_proven"],
      "properties": {
        "overlap_proven": { "type": "boolean" },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["job_id", "job_type", "started_at", "ended_at", "duration_ms"],
            "properties": {
              "job_id": { "type": "string", "maxLength": 64 },
              "job_type": { "type": "string", "maxLength": 64 },
              "started_at": { "type": "string", "maxLength": 64 },
              "ended_at": { "type": "string", "maxLength": 64 },
              "duration_ms": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "x-metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["category", "severity", "confidence", "blocking", "rule", "evidence", "recommendation"],
      "properties": {
        "category": { "enum": ["correctness", "security", "quality"] },
        "severity": { "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "blocking": { "type": "boolean" },
        "rule": { "type": "string", "minLength": 3, "maxLength": 64 },
        "evidence": {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "maxLength": 256 },
            "symbol": { "type": "string", "maxLength": 128 },
            "line_range": { "type": "string", "maxLength": 64 }
          },
          "additionalProperties": false
        },
        "recommendation": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
