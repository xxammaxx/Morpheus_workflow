{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autodev.build-input.v1",
  "title": "AutoDev Build Input Contract v1",
  "description": "The ONLY input the build worker may consume. Built deterministically from plan + verification context.",
  "type": "object",
  "x-metadata": [
    "job_id",
    "attempt_id",
    "started_at",
    "ended_at",
    "duration_ms",
    "provider",
    "model",
    "backend"
  ],
  "required": [
    "contract",
    "version",
    "run_id",
    "plan_fingerprint",
    "repository_head",
    "targets",
    "acceptance_criteria",
    "required_tests",
    "build_scope"
  ],
  "properties": {
    "contract": {
      "const": "autodev.build-input.v1"
    },
    "version": {
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 64
    },
    "attempt_id": {
      "type": "string",
      "maxLength": 96
    },
    "plan_fingerprint": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "repository_head": {
      "type": "string",
      "minLength": 7,
      "maxLength": 64
    },
    "targets": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "required_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "changes_expected": {
      "type": "boolean"
    },
    "build_scope": {
      "type": "object",
      "required": [
        "allowed_files"
      ],
      "properties": {
        "allowed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "additionalProperties": false
    },
    "task_description": {
      "type": "string",
      "maxLength": 4000
    },
    "strategy_delta": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "failure_context": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "failure_signature"
      ],
      "properties": {
        "failure_signature": {
          "type": "string",
          "maxLength": 128
        },
        "failure_class": {
          "type": "string",
          "maxLength": 64
        },
        "new_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "additionalProperties": false
    },
    "x-metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
