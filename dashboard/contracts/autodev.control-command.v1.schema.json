{
  "$id": "autodev.control-command.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authenticated Control Tower command",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "command", "target", "payload", "actor", "correlation_id"],
  "properties": {
    "contract": {"const": "autodev.control-command.v1"},
    "version": {"const": "v1"},
    "command": {"enum": ["START_PROJECT", "START_ISSUE", "START_REPO_ANALYSIS", "START_BLUEPRINT_PROJECT", "PAUSE_RUN", "RESUME_RUN", "ABORT_RUN", "RETRY_STAGE", "RETRY_RUN", "EXCLUDE_MODEL_FOR_RUN", "EXCLUDE_PROVIDER_FOR_RUN", "APPROVE_HUMAN_GATE", "RUN_ROUTER_TEST", "RUN_MCP_TEST", "RUN_SYSTEM_TEST", "REFRESH_CATALOG", "SYNC_CREDENTIALS"]},
    "target": {"type": "object", "additionalProperties": true},
    "payload": {"type": "object", "additionalProperties": true},
    "actor": {"type": "object", "required": ["role"], "properties": {"role": {"enum": ["OPERATOR", "ADMIN"]}}, "additionalProperties": false},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{3,96}$"}
  }
}
