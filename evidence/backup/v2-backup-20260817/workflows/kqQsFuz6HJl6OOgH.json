    {
      "parameters": {
        "jsCode": "// Parse and classify status for notification routing\nconst fileData = $input.first().json.data;\nlet statusData;\ntry {\n  statusData = JSON.parse(fileData);\n} catch (e) {\n  return [{ json: { error: 'Failed to parse status.json', overall_status: 'UNKNOWN', route: 'UNKNOWN', severity: 'error' } }];\n}\n\nconst rawStatus = statusData.overall_status;\nconst status = (typeof rawStatus === 'string' && rawStatus.trim().length > 0)\n  ? String(rawStatus).trim().toUpperCase()\n  : 'UNKNOWN';\n\nlet route = 'UNKNOWN';\nlet severity = 'review';\nlet canNotify = false;\nlet notificationTitle = '';\nlet notificationBody = '';\n\nif (status === 'RED_BLOCK') {\n  route = 'BLOCK'; severity = 'critical'; canNotify = true;\n  notificationTitle = '???? CRITICAL: Agent Run BLOCKED';\n  notificationBody = `Project: ${statusData.project || 'mission-driven-agent-loop'}\\nStatus: RED_BLOCK\\nRuns Found: ${statusData.runs_found || 'N/A'}\\nImmediate investigation required.`;\n} else if (status === 'YELLOW_REVIEW' || status === 'NEEDS_VALIDATION') {\n  route = 'REVIEW'; severity = 'warning'; canNotify = true;\n  notificationTitle = status === 'YELLOW_REVIEW' ? '?????? Agent Run Review Required' : '???? Agent Run Needs Validation';\n  notificationBody = `Project: ${statusData.project || 'mission-driven-agent-loop'}\\nStatus: ${status}\\nRuns Found: ${statusData.runs_found || 'N/A'}\\nHuman review required.`;\n} else if (status === 'GREEN_SAFE') {\n  route = 'GREEN'; severity = 'info'; canNotify = false;\n  notificationTitle = '??? Agent Loop ??? GREEN_SAFE';\n  notificationBody = `Project: ${statusData.project || 'mission-driven-agent-loop'}\\nStatus: GREEN_SAFE\\nAll runs passed. No notification needed.`;\n} else if (status === 'TOOL_GAP') {\n  route = 'TOOL_GAP'; severity = 'warning'; canNotify = true;\n  notificationTitle = '???? Tool Gap Detected';\n  notificationBody = `Project: ${statusData.project || 'mission-driven-agent-loop'}\\nStatus: TOOL_GAP\\nRequired tools unavailable.`;\n} else if (status === 'STALE') {\n  route = 'STALE'; severity = 'info'; canNotify = true;\n  notificationTitle = '??? Stale Run Data';\n  notificationBody = `Project: ${statusData.project || 'mission-driven-agent-loop'}\\nStatus: STALE\\nNo recent runs (older than 7 days).`;\n} else {\n  route = 'UNKNOWN'; severity = 'review'; canNotify = true;\n  notificationTitle = '??? Unknown Agent Loop Status';\n  notificationBody = `Project: ${statusData.project || 'mission-driven-agent-loop'}\\nStatus: UNKNOWN\\nManual review required.`;\n}\n\nreturn [{\n  json: {\n    project: statusData.project || 'unknown',\n    overall_status: status,\n    runs_found: statusData.runs_found || 0,\n    route: route,\n    severity: severity,\n    canNotify: canNotify,\n    notification: {\n      title: notificationTitle,\n      body: notificationBody,\n      severity: severity,\n      timestamp: new Date().toISOString()\n    }\n  }\n}];"
      },
      "name": "Classify & Prepare Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "notes": "CRITICAL: Explicit === comparisons. NO IF Nodes. See n8n/code-nodes/status-router.js.",
