    {
      "parameters": {
        "jsCode": "// ================================================================\n// approval-router.js ??? Phase 3B Manual Approval Routing\n// CRITICAL: Explicit === string comparisons. NO truthy/falsy logic.\n// ALL approval values set canStartRunner = false.\n// APPROVE_NEXT_DRY_RUN is DOCUMENTATION-ONLY.\n// ================================================================\n\nconst rawApproval = $input.first().json.approval || $input.first().json.action;\nconst approval = (typeof rawApproval === 'string' && rawApproval.trim().length > 0)\n  ? String(rawApproval).trim().toUpperCase()\n  : 'PAUSE';\n\nconst runId = $input.first().json.run_id || 'UNKNOWN';\nconst reviewer = $input.first().json.reviewer || 'UNKNOWN';\nconst comment = $input.first().json.comment || '';\nconst timestamp = new Date().toISOString();\n\nlet route = 'PAUSE';\nlet canStartRunner = false;\nlet requiredHumanReview = true;\nlet decisionRationale = '';\nlet approvalRecorded = false;\n\nif (approval === 'APPROVE_NEXT_DRY_RUN') {\n  route = 'APPROVED_DRY_RUN_ONLY';\n  canStartRunner = false;\n  requiredHumanReview = true;\n  decisionRationale = 'Approved for next dry-run only. Runner NOT started. Phase 4 required for actual execution.';\n  approvalRecorded = true;\n} else if (approval === 'PAUSE') {\n  route = 'PAUSE';\n  canStartRunner = false;\n  requiredHumanReview = true;\n  decisionRationale = 'Run paused. Awaiting further instructions.';\n  approvalRecorded = true;\n} else if (approval === 'REJECT') {\n  route = 'REJECTED';\n  canStartRunner = false;\n  requiredHumanReview = true;\n  decisionRationale = 'Run rejected. No further action will be taken.';\n  approvalRecorded = true;\n} else if (approval === 'REQUEST_MORE_EVIDENCE') {\n  route = 'MORE_EVIDENCE';\n  canStartRunner = false;\n  requiredHumanReview = true;\n  decisionRationale = 'Additional evidence requested before approval can proceed.';\n  approvalRecorded = true;\n} else {\n  route = 'PAUSE';\n  canStartRunner = false;\n  requiredHumanReview = true;\n  decisionRationale = 'Unrecognized approval value: \"' + rawApproval + '\". Defaulting to PAUSE. Valid values: APPROVE_NEXT_DRY_RUN, PAUSE, REJECT, REQUEST_MORE_EVIDENCE.';\n  approvalRecorded = false;\n}\n\nconst approvalRecord = {\n  approval_id: 'approval-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8),\n  run_id: runId,\n  reviewer: reviewer,\n  action: approval,\n  route: route,\n  comment: comment,\n  timestamp: timestamp,\n  canStartRunner: canStartRunner,\n  requiredHumanReview: requiredHumanReview,\n  decisionRationale: decisionRationale,\n  phase: '3B_BLUEPRINT_ONLY',\n  note: 'This is a Phase 3B blueprint. No runner was started. Phase 4 will enable actual execution.'\n};\n\nreturn [{\n  json: {\n    run_id: runId,\n    reviewer: reviewer,\n    route: route,\n    canStartRunner: canStartRunner,\n    requiredHumanReview: requiredHumanReview,\n    approval: approvalRecord,\n    decisionRationale: decisionRationale,\n    approvalRecorded: approvalRecorded,\n    status: approvalRecorded ? 'RECORDED' : 'FAILED',\n    timestamp: timestamp\n  }\n}];"
      },
